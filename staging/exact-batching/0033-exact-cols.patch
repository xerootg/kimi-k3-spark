+// Routing uses the same production fused kernel, including singleton tie order.
+static void ggml_cuda_exact_topk_moe(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * logits,
+        ggml_tensor * weights, ggml_tensor * ids, const ggml_tensor * clamp,
+        const ggml_tensor * scale, const ggml_tensor * bias,
+        const ggml_cuda_topk_moe_args & args) {
+    const int64_t n = logits->ne[1];
+    if (!ggml_cuda_exact_cols() || n < 2 || n > 8) {
+        ggml_cuda_op_topk_moe(ctx, logits, weights, ids, clamp, scale, bias, args);
+        return;
+    }
+    GGML_ASSERT(logits->ne[2] == 1 && logits->ne[3] == 1);
+    GGML_ASSERT(weights->ne[2] == n && weights->ne[3] == 1 && ids->ne[1] == n);
+    for (int64_t col = 0; col < n; ++col) {
+        ggml_tensor x = *logits, w = *weights, id = *ids;
+        x.ne[1] = w.ne[2] = id.ne[1] = 1;
+        x.data = (char *) logits->data + col * logits->nb[1];
+        w.data = (char *) weights->data + col * weights->nb[2];
+        id.data = (char *) ids->data + col * ids->nb[1];
+        ggml_cuda_op_topk_moe(ctx, &x, &w, &id, clamp, scale, bias, args);
+    }
+}

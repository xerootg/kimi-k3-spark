     GGML_TENSOR_BINARY_OP_LOCALS
 
+    // Head rows live in ne[1] for the indexer rotation; tokens live in ne[2].
+    // Restrict this rule to a broadcast weight: a per-head weight's ne[2]
+    // is a head axis, not a token axis (wk_b / q_nope_absorbed).
+    if (ggml_cuda_exact_cols() && dst->ne[2] >= 2 && dst->ne[2] <= 8 &&
+        src0->ne[2] == 1 && src1->ne[2] == dst->ne[2]) {
+        const size_t row_bytes = ggml_row_size(dst->type, dst->ne[0]);
+        GGML_ASSERT(dst->nb[0] == ggml_type_size(dst->type));
+        ggml_cuda_pool_alloc<char> packed(ctx.pool(), row_bytes * dst->ne[1] * dst->ne[3]);
+        for (int64_t token = 0; token < dst->ne[2]; ++token) {
+            ggml_tensor input = *src1;
+            ggml_tensor output = *dst;
+            input.ne[2] = output.ne[2] = 1;
+            input.data = (char *) src1->data + token * src1->nb[2];
+            output.nb[1] = row_bytes;
+            output.nb[2] = output.nb[3] = row_bytes * output.ne[1];
+            output.data = packed.get();
+            output.src[0] = const_cast<ggml_tensor *>(src0);
+            output.src[1] = &input;
+            ggml_cuda_mul_mat(ctx, src0, &input, &output);
+            for (int64_t i3 = 0; i3 < output.ne[3]; ++i3) {

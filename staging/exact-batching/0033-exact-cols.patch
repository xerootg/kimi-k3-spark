+                    CUDA_CHECK(cudaMemcpyAsync(
+                        (char *) dst->data + token * dst->nb[2] + row * dst->nb[1] + i3 * dst->nb[3],
+                        packed.get() + row * output.nb[1] + i3 * output.nb[3],
+                        row_bytes, cudaMemcpyDeviceToDevice, ctx.stream()));
+                }
+            }
+        }
+        return;
+    }
+
+    // Deliberately split all 2..8-column ordinary matmuls, including kernels
+    // whose family stays the same but whose reduction geometry changes (MMVQ).
+    // Keep original higher-dimensional strides and broadcast dimensions.
+    if (ggml_cuda_exact_cols() && dst->ne[1] >= 2 && dst->ne[1] <= 8) {
+        GGML_ASSERT(src1->ne[1] == dst->ne[1]);
+        GGML_ASSERT(dst->nb[0] == ggml_type_size(dst->type));
+        ggml_cuda_pool_alloc<char> packed(ctx.pool());
+        const size_t row_bytes = ggml_row_size(dst->type, dst->ne[0]);
+        packed.alloc(row_bytes * dst->ne[2] * dst->ne[3]);
+        for (int64_t col = 0; col < dst->ne[1]; ++col) {
+            ggml_tensor input = *src1;
+            ggml_tensor output = *dst;
+            input.ne[1] = output.ne[1] = 1;
+            input.data = (char *) src1->data + col * src1->nb[1];
+            // A packed singleton destination also supports cuBLAS conversion
+            // buffers, which require contiguous outputs for F16/BF16 compute.
+            output.nb[1] = output.nb[2] = row_bytes;
+            output.nb[3] = row_bytes * output.ne[2];
+            output.data = packed.get();
+            output.src[0] = const_cast<ggml_tensor *>(src0);
+            output.src[1] = &input;
+            // Re-enter before FWHT, padding checks and every backend heuristic.
+            // The singleton branch terminates recursion and preserves precision.
+            ggml_cuda_mul_mat(ctx, src0, &input, &output);
+            for (int64_t i3 = 0; i3 < output.ne[3]; ++i3) {

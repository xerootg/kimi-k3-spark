+    void valve_sample(bool psi) {
+        const auto now = std::chrono::steady_clock::now();
+        const size_t host = host_available();
+        if (host == SIZE_MAX) {
+            return;
+        }
+        valve_last_host = host;
+        valve_lowest_host = std::min(valve_lowest_host, host);
+        const int hn = hbm_node();
+        size_t hbm = SIZE_MAX;
+        if (hn >= 0) {
+            hbm = node_free(hn);

+                // miss would evict a hit of the same batch and the lookup would read -1 for it
+                while (s >= 0 && key_of[s] >= 0 && key_of[s] / n_expert == il && seen[key_of[s] % n_expert] == seen_gen) {
+                    s = next[s];
+                }
+                GGML_ASSERT(s >= 0);
+            }
             if (key_of[s] >= 0) {
                 slot_map[key_of[s] / n_expert][key_of[s] % n_expert] = -1;
+            } else {
+                n_filled++;
             }
             key_of[s] = il*n_expert + e;
             slots[e] = s;
             touch(s);
             fills.push_back({ e, s });
         }
+        if (scan) {
+            // a prefill fill into a full cache is one-shot: park it at the head, the next fill evicts it before the
+            // working set of the generation
+            for (const fill & f : fills) {
+                demote(f.slot);
+            }
+        }
+        return true;
+    }
+};

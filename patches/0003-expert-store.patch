+        bool any = false;
+        for (group & g : groups) {
+            if (g.region != nullptr && g.n_slots > 0) {
+                any = true;
+                if (!g.spec_state) {
+                    g.spec_state.reset(new std::atomic<int8_t>[g.n_slots]);
+                    for (int32_t s = 0; s < g.n_slots; ++s) {

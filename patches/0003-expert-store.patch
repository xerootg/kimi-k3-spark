+        if (hfd < 0) {
+            err = std::string("open: ") + strerror(errno);
+            return false;
+        }
+        uint8_t hdr[64];
+        if (pread(hfd, hdr, sizeof(hdr), 0) != (ssize_t) sizeof(hdr) || memcmp(hdr, "K3XS", 4) != 0) {

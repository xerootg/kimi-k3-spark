+static void store_region_free(void * p, size_t size) {
+#if defined(__linux__)
+    if (p != nullptr) {
+        munmap(p, size);
+    }
+#else
+    GGML_UNUSED(p);
+    GGML_UNUSED(size);
+#endif
+}

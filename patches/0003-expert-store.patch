+                        cg_oom_kill = v;
+                    } else if (sscanf(line, "high %llu", &v) == 1 && v != cg_high) {
+                        LLAMA_LOG_WARN("%s: expert store: memory valve: the cgroup crossed memory.high %llu times\n", __func__, v);
+                        cg_high = v;
+                    }

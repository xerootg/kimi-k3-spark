+        // double-buffered partials: one __syncthreads per tile also releases the stage for the refill
+        if (threadIdx.y > 0) {
+#pragma unroll
+            for (int i = 0; i < R; ++i) {
+                tmp_shared[k & 1][threadIdx.y-1][i][threadIdx.x] = tmp[i];
+                if constexpr (has_fusion) {
+                    if (use_gate) {

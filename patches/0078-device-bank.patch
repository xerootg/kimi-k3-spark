+#else
+    GGML_UNUSED(dst); GGML_UNUSED(src); GGML_UNUSED(n);
+    return false;
+#endif
+}
+
+bool ggml_backend_cuda_bank_memset(void * dst, int value, size_t n) {
+#ifdef GGML_CUDA_HOST_BANK_ASYNC_SUPPORTED
+    return ggml_cuda_bank_copy_wait(ggml_cuda_bank_copy_enqueue([&](cudaStream_t s) { return cudaMemsetAsync(dst, value, n, s); }));
+#else
+    GGML_UNUSED(dst); GGML_UNUSED(value); GGML_UNUSED(n);
+    return false;
+#endif

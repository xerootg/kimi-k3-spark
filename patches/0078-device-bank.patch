+
+// One non-blocking stream for the bank copies. The callers (the poller inside the lookup hook, the fill thread, the
+// speculative reader) never call a blocking CUDA API: a cudaStreamSynchronize from the poller did not return while
+// the main thread spun in cuLaunchKernelEx on a full launch queue and the GPU waited on the mailbox (2026-11-27).
+// Instead the copy stream writes a sequence number to mapped host memory after each copy (cuStreamWriteValue32)
+// and the caller spins on that word. Needs the driver API, like the mailbox: without it the device bank is
+// unsupported (the allocation returns nullptr) and the copies report failure.
+#ifdef GGML_CUDA_HOST_BANK_ASYNC_SUPPORTED
+struct ggml_cuda_bank_copy_state {
+    cudaStream_t         stream = nullptr;
+    volatile uint32_t *  seq_h  = nullptr;
+    CUdeviceptr          seq_d  = 0;
+    uint32_t             next   = 0;
+    std::mutex           mutex;
+    bool                 ok     = false;
+};
+static ggml_cuda_bank_copy_state & ggml_cuda_bank_copy() {
+    static ggml_cuda_bank_copy_state st;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        ggml_cuda_set_device(0);
+        void * p = nullptr;
+        if (cudaStreamCreateWithFlags(&st.stream, cudaStreamNonBlocking) == cudaSuccess &&
+            cudaHostAlloc(&p, 4096, cudaHostAllocMapped | cudaHostAllocPortable) == cudaSuccess) {
+            void * d = nullptr;
+            memset(p, 0, 4096);
+            if (cudaHostGetDevicePointer(&d, p, 0) == cudaSuccess) {
+                st.seq_h = (volatile uint32_t *) p;
+                st.seq_d = (CUdeviceptr) (uintptr_t) d;
+                st.ok = true;
+            }
+        }
+        (void) cudaGetLastError();
+    });
+    return st;
+}
+// enqueue op(stream) and the sequence write behind it; 0 when nothing was queued (op failed), otherwise the
+// sequence to wait for. A write-value failure after a queued op leaves a copy in flight without a marker: abort,
+// as a caller that gave up would reuse the staging and the slot under it.
+template <typename F> static uint32_t ggml_cuda_bank_copy_enqueue(F op) {
+    ggml_cuda_bank_copy_state & st = ggml_cuda_bank_copy();
+    if (!st.ok) {
+        return 0;
+    }
+    std::lock_guard<std::mutex> lock(st.mutex);
+    const uint32_t seq = ++st.next == 0 ? ++st.next : st.next;
+    if (op(st.stream) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return 0;
+    }
+    if (cuStreamWriteValue32((CUstream) st.stream, st.seq_d, seq, CU_STREAM_WRITE_VALUE_DEFAULT) != CUDA_SUCCESS) {
+        GGML_ABORT("device bank: a copy was queued but its completion marker could not be (sequence %u)", seq);
+    }
+    return seq;
+}
+static bool ggml_cuda_bank_copy_wait(uint32_t seq) {
+    if (seq == 0) {
+        return false;
+    }
+    ggml_cuda_bank_copy_state & st = ggml_cuda_bank_copy();
+    const auto t0 = std::chrono::steady_clock::now();
+    while ((int32_t) (*st.seq_h - seq) < 0) {
+#if defined(__aarch64__)
+        asm volatile("yield" ::: "memory");
+#endif
+        if (std::chrono::steady_clock::now() - t0 > std::chrono::seconds(60)) {
+            // the copy is still queued and would land in buffers the caller is about to reuse: no recovery
+            GGML_ABORT("device bank: a copy did not complete in 60 s (sequence %u, last completed %u)", seq, *st.seq_h);
+        }
+    }
+    return true;
+}
+#endif // GGML_CUDA_HOST_BANK_ASYNC_SUPPORTED

+// kimi-k3-spark patch 0078: the expert bank in device memory. On the GB10 the host bank (anonymous memory registered
+// with cudaHostRegister, read through the host page tables) streams at ~165 GB/s where the same kernel reads a
+// cudaMalloc allocation at ~227 GB/s (tools: mmvq-bench2, 2026-11-27). The CPU cannot write device memory, so the
+// store lands its reads in pinned staging and copies every record in with ggml_backend_cuda_bank_upload before it
+// is published. The buffer carries the host-bank buffer type, so the lookup hooks, the split GEMV and the scheduler
+// treat it exactly as the registered bank; only the address the kernels read from changes.
+ggml_backend_buffer_t ggml_backend_cuda_device_bank_buffer_alloc(size_t size) {
+#ifndef GGML_CUDA_HOST_BANK_ASYNC_SUPPORTED
+    GGML_LOG_ERROR("%s: the device bank needs the CUDA driver API (stream memory operations)\n", __func__);
+    GGML_UNUSED(size);
+    return nullptr;
+#else
+    ggml_cuda_set_device(0);
+    void * p = nullptr;
+    cudaError_t err = cudaMalloc(&p, size);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        GGML_LOG_ERROR("%s: cudaMalloc of %.2f MiB for the device bank failed: %s\n", __func__, size/1024.0/1024.0, cudaGetErrorString(err));
+        return nullptr;
+    }
+    CUDA_CHECK(cudaMemset(p, 0, size));
+    CUDA_CHECK(cudaDeviceSynchronize());
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(0, p);
+    GGML_LOG_INFO("%s: device bank: %.2f MiB in device memory at %p\n", __func__, size/1024.0/1024.0, p);
+    return ggml_backend_buffer_init(ggml_backend_cuda_device_bank_buffer_type(), ggml_backend_cuda_buffer_interface, ctx, size);
+#endif

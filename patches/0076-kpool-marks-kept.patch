diff --git a/src/llama-memory-hybrid-idx.h b/src/llama-memory-hybrid-idx.h
index 0ac4265..c66f387 100644
--- a/src/llama-memory-hybrid-idx.h
+++ b/src/llama-memory-hybrid-idx.h
@@ -92,6 +92,19 @@ public:
     const kpool_layout & kpool_layout_update();
     const kpool_layout & kpool_layout_get() const;
 
+    // patch 0076: the scratch of kpool_build_state that is sized by the whole cache (one stamp of 4 bytes per cell of
+    // every stream). It is kept here because the batch context, and with it the k-pool state, is made anew for every
+    // llama_decode call: as a member of that state the array was allocated and zeroed once per decode step, 20 MiB
+    // with five slots of 1M cells (1.3-1.6 ms per step measured alone on the Spark and the GH200) against 3.9 MiB with
+    // five slots of 204800. A stamp only means something within the call that wrote it (the generation is bumped at
+    // the start of every call), so sharing the array between contexts of this memory changes nothing.
+    struct kpool_marks {
+        std::vector<uint32_t> rep_gen; // per global cell, the generation that last marked a pool with that rep
+        uint32_t generation = 0;
+    };
+
+    kpool_marks & kpool_marks_get() { return kpool_mk; }
+
     // The pooled keys persist in the idx cache across batches. A sequence edit can regroup the pools
     // from some position on, which stales every pooled key at or after it. POS_CLEAN means none.
     using stale_pos_t = std::array<llama_pos, LLAMA_MAX_SEQ>;
@@ -121,6 +134,8 @@ private:
     // unique_ptr because kpool_layout is incomplete here
     std::unique_ptr<kpool_layout> kpool_lay;
 
+    kpool_marks kpool_mk; // patch 0076
+
     // seq_id < 0 stales every sequence, p0 < 0 stales the sequence from its first position
     void mem_idx_stale_set(llama_seq_id seq_id, llama_pos p0);
 

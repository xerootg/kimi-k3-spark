+// kimi-k3-spark patch 0059: with LLAMA_PREFILL_ISOLATE=1 (patch 0035) a prompt ubatch always holds one sequence, so the
+// prompt graph is reserved for one sequence over one KV stream. The default worst case spreads the ubatch over every slot,
+// and with non-unified KV each of them views its whole stream: on the GH200 five 1M slots reserved 40.2 GB of compute
+// buffer instead of 28.0 GB, and the HBM expert tier paid for the difference. Batched decode (n_seq_max sequences of one
+// token each) is still reserved as before.
+bool llama_context::pp_reserve_one_seq() const {
+    static const bool isolate = [] {
+        const char * v = getenv("LLAMA_PREFILL_ISOLATE");
+        return v != nullptr && strcmp(v, "1") == 0;
+    }();
+    return isolate && cparams.n_seq_max > 1 && !cparams.kv_unified;
+}
+
+llama_memory_context_ptr llama_context::pp_reserve_mctx() {
+    llama_kv_cache_set_reserve_one_stream(true);
+    llama_memory_context_ptr res = memory->init_full();
+    llama_kv_cache_set_reserve_one_stream(false);
+    if (!res) {
+        throw std::runtime_error("failed to initialize memory module");
+    }
+    return res;
+}

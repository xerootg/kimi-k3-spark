--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -786,9 +786,16 @@ void llama_context::sched_reserve() {
     {
         const char * v = getenv("LLAMA_PREFILL_SLICE_LAYERS");
         const int k = v ? atoi(v) : 0;
-        pp_slice_layers = (k > 0 && pp_reserve_one_seq()) ? k : 0;
+        // patch 0077: only the target context computes prompts in pieces. The MTP draft context (patch 0070) is driven
+        // by common/speculative, which never calls llama_decode_resume: a 3 from its decode would be an error there.
+        const bool target = cparams.ctx_type == LLAMA_CONTEXT_TYPE_DEFAULT;

     const int64_t n = experts->ne[2] * experts->ne[3];
-    if (!ggml_cuda_exact_cols() || n < 2 || n > 8) {
+    // patch 0067: in batch-invariant mode only the strided split-column layout is folded token by token (the kernel
+    // is per token, so the bits are those of the one launch); contiguous experts keep the one launch
+    const bool strided = ggml_cuda_batch_invariant() && !ggml_is_contiguous(experts);
+    if ((!ggml_cuda_exact_cols() && !strided) || n < 2 || n > 8) {

+// Dense fusion uses the production epilogue inside each singleton launch.
+// Split routed fusion before conversion, with optional joint shared output.
+static void ggml_cuda_exact_fused_matvec(
+        bool quantized, ggml_backend_cuda_context & ctx,
+        const ggml_tensor * weight, const ggml_tensor * input, const ggml_tensor * ids,
+        ggml_tensor * dst, const ggml_cuda_mm_fusion_args_host * fusion) {
+    const bool token_axis = !ids && weight->ne[2] == 1 && dst->ne[2] >= 2 && dst->ne[2] <= 8 && input->ne[2] == dst->ne[2];
+    const auto n = ids || token_axis ? dst->ne[2] : dst->ne[1];
+    const auto kind = ids ? (quantized ? ggml_cuda_exact_stats::FUSED_ID_Q : ggml_cuda_exact_stats::FUSED_ID_F)
+                          : (quantized ? ggml_cuda_exact_stats::FUSED_Q : ggml_cuda_exact_stats::FUSED_F);
+    ggml_cuda_exact_stats::scope stats(kind, ggml_cuda_exact_cols() && n >= 2 && n <= 8, n);
+    auto launch = [&](const ggml_tensor * x, const ggml_tensor * id, ggml_tensor * y,
+                      const ggml_cuda_mm_fusion_args_host * f) {
+        if (quantized) {
+            ggml_cuda_mul_mat_vec_q(ctx, weight, x, id, y, f);
+        } else {
+            ggml_cuda_mul_mat_vec_f(ctx, weight, x, id, y, f);
+        }
+    };
+    // Preserve singleton conversion and epilogues for every routed fusion.
+    if (ggml_cuda_exact_cols() && ids && dst->ne[2] >= 2 && dst->ne[2] <= 8) {
+        GGML_ASSERT(input->ne[2] == dst->ne[2] && ids->ne[1] == dst->ne[2]);
+        GGML_ASSERT(dst->ne[3] == 1 && input->ne[3] == 1);
+        for (int64_t col = 0; col < dst->ne[2]; ++col) {
+            ggml_tensor x = *input, y = *dst, id = *ids, shared;
+            x.ne[2] = y.ne[2] = id.ne[1] = 1;
+            x.data = (char *) input->data + col * input->nb[2];
+            y.data = (char *) dst->data + col * dst->nb[2];
+            id.data = (char *) ids->data + col * ids->nb[1];
+            y.src[0] = const_cast<ggml_tensor *>(weight);
+            y.src[1] = &x;
+            y.src[2] = &id;
+            auto f = *fusion;
+            if (f.shared_dst) {
+                GGML_ASSERT(quantized && input->ne[1] == 1);
+                GGML_ASSERT(f.shared_dst->ne[1] == dst->ne[2]);
+                shared = *f.shared_dst;
+                shared.ne[1] = 1;
+                shared.data = (char *) shared.data + col * shared.nb[1];
+                f.shared_dst = &shared;
+            }
+            // Biases and scales are expert-indexed; gate/up weights are shared.
+            launch(&x, &id, &y, &f);
+        }
+        return;
+    }
+    if (ggml_cuda_exact_cols() && !ids && weight->ne[2] == 1 &&
+            dst->ne[2] >= 2 && dst->ne[2] <= 8 && input->ne[2] == dst->ne[2]) {
+        const size_t bytes = ggml_row_size(dst->type, dst->ne[0]);
+        ggml_cuda_exact_scratch packed(ctx, bytes * dst->ne[1] * dst->ne[3]);
+        for (int64_t token = 0; token < dst->ne[2]; ++token) {
+            ggml_tensor x = *input, y = *dst;
+            x.ne[2] = y.ne[2] = 1;
+            x.data = (char *) input->data + token * input->nb[2];
+            y.nb[1] = bytes;
+            y.nb[2] = y.nb[3] = bytes * y.ne[1];
+            y.data = packed.get();
+            y.src[0] = const_cast<ggml_tensor *>(weight);
+            y.src[1] = &x;
+            auto f = *fusion;
+            ggml_tensor bias, gate_bias;
+            auto slice_bias = [&](const ggml_tensor * t, ggml_tensor & one) -> const ggml_tensor * {
+                if (!t || t->ne[2] == 1) { return t; }
+                GGML_ASSERT(t->ne[2] == dst->ne[2]);
+                one = *t;
+                one.ne[2] = 1;
+                one.data = (char *) t->data + token * t->nb[2];
+                return &one;
+            };
+            f.x_bias = slice_bias(f.x_bias, bias);
+            f.gate_bias = slice_bias(f.gate_bias, gate_bias);
+            ggml_cuda_exact_fused_matvec(quantized, ctx, weight, &x, ids, &y, &f);
+            for (int64_t i3 = 0; i3 < y.ne[3]; ++i3) {
+                for (int64_t row = 0; row < y.ne[1]; ++row) {
+                    CUDA_CHECK(cudaMemcpyAsync(
+                        (char *) dst->data + token * dst->nb[2] + row * dst->nb[1] + i3 * dst->nb[3],
+                        packed.get() + row * y.nb[1] + i3 * y.nb[3],
+                        bytes, cudaMemcpyDeviceToDevice, ctx.stream()));
+                }
+            }
+        }
+        return;
+    }
+    if (!ggml_cuda_exact_cols() || ids || dst->ne[1] < 2 || dst->ne[1] > 8) {
+        launch(input, ids, dst, fusion);
+        return;
+    }
+    const size_t row_bytes = ggml_row_size(dst->type, dst->ne[0]);
+    ggml_cuda_exact_scratch packed(ctx, row_bytes * dst->ne[2] * dst->ne[3]);
+    for (int64_t col = 0; col < dst->ne[1]; ++col) {
+        ggml_tensor x = *input, y = *dst;
+        x.ne[1] = y.ne[1] = 1;
+        x.data = (char *) input->data + col * input->nb[1];
+        y.nb[1] = y.nb[2] = row_bytes;
+        y.nb[3] = row_bytes * y.ne[2];
+        y.data = packed.get();
+        y.src[0] = const_cast<ggml_tensor *>(weight);
+        y.src[1] = &x;
+        auto f = *fusion;
+        ggml_tensor bias, gate_bias;
+        auto slice_bias = [&](const ggml_tensor * t, ggml_tensor & one) -> const ggml_tensor * {
+            if (!t || t->ne[1] == 1) { return t; }
+            GGML_ASSERT(t->ne[1] == dst->ne[1] && t->ne[2] == 1 && t->ne[3] == 1);
+            one = *t;
+            one.ne[1] = 1;
+            one.data = (char *) t->data + col * t->nb[1];
+            return &one;
+        };
+        f.x_bias = slice_bias(f.x_bias, bias);
+        f.gate_bias = slice_bias(f.gate_bias, gate_bias);
+        GGML_ASSERT(!f.shared_dst);
+        launch(&x, ids, &y, &f);
+        for (int64_t i3 = 0; i3 < y.ne[3]; ++i3) {
+            for (int64_t i2 = 0; i2 < y.ne[2]; ++i2) {
+                CUDA_CHECK(cudaMemcpyAsync(
+                    (char *) dst->data + col * dst->nb[1] + i2 * dst->nb[2] + i3 * dst->nb[3],
+                    packed.get() + i2 * y.nb[2] + i3 * y.nb[3],
+                    row_bytes, cudaMemcpyDeviceToDevice, ctx.stream()));
+            }
+        }
+    }
+}

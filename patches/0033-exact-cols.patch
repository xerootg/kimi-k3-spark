+// Replay the N=1 fused fold, preserving token strides of split-bank views.
+static void ggml_cuda_exact_moe_weighted_reduction(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * experts,
+        const ggml_tensor * expert_scale, const ggml_tensor * weights, ggml_tensor * dst) {
+    const int64_t n = experts->ne[2] * experts->ne[3];
+    if (!ggml_cuda_exact_cols() || n < 2 || n > 8) {
+        ggml_cuda_op_moe_weighted_reduction(ctx, experts, expert_scale, weights, dst);
+        return;
+    }
+    for (int64_t col = 0; col < n; ++col) {
+        auto slice = [col](const ggml_tensor * src) {
+            ggml_tensor t = *src;
+            t.data = (char *) src->data + (col % src->ne[2]) * src->nb[2] +
+                (col / src->ne[2]) * src->nb[3];
+            t.ne[2] = t.ne[3] = 1;
+            t.nb[2] = t.ne[1] * t.nb[1];
+            t.nb[3] = t.nb[2];
+            return t;
+        };
+        ggml_tensor e = slice(experts), w = slice(weights), y = *dst, scale;
+        y.data = (char *) dst->data + col * dst->nb[1];
+        y.ne[1] = 1;
+        y.nb[2] = y.nb[3] = y.nb[1];
+        if (expert_scale) { scale = slice(expert_scale); }
+        ggml_cuda_op_moe_weighted_reduction(ctx, &e, expert_scale ? &scale : nullptr, &w, &y);
+    }
+}

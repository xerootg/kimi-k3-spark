diff --git a/ggml/src/ggml-cuda/exact-stats.cuh b/ggml/src/ggml-cuda/exact-stats.cuh
new file mode 100644
index 0000000..761c278
--- /dev/null
+++ b/ggml/src/ggml-cuda/exact-stats.cuh
@@ -0,0 +1,45 @@
+#pragma once
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// Host dispatch decisions, including CUDA graph capture, not graph replays.
+// Count an outer invocation once; singleton recursive launches are excluded.
+namespace ggml_cuda_exact_stats {
+enum kind { MUL_MAT, MUL_MAT_ID, FUSED_F, FUSED_Q, FUSED_ID_F, FUSED_ID_Q, FUSED_TOPK, COUNT };
+inline bool enabled() {
+    static const bool on = [] {
+        const char * e = std::getenv("GGML_CUDA_EXACT_COLS");
+        const char * s = std::getenv("GGML_CUDA_EXACT_STATS");
+        return e && s && std::strcmp(e, "1") == 0 && std::strcmp(s, "1") == 0;
+    }();
+    return on;
+}
+struct totals {
+    std::atomic<unsigned long long> split[COUNT]{}, batched[COUNT]{}, singleton[COUNT]{};
+    ~totals() {
+        const char * names[] = {"MUL_MAT", "MUL_MAT_ID", "FUSED_F", "FUSED_Q", "FUSED_ID_F", "FUSED_ID_Q", "FUSED_TOPK"};
+        for (int i = 0; i < COUNT; ++i) {
+            std::fprintf(stderr, "exact dispatch: split=%llu batched=%llu singleton=%llu class=%s (host calls; includes capture, excludes replay)\n",
+                split[i].load(), batched[i].load(), singleton[i].load(), names[i]);
+        }
+    }
+};
+inline totals & get() { static totals t; return t; }
+inline void record(kind k, bool split, long long columns) {
+    if (!enabled()) { return; }
+    auto & t = get();
+    auto & counter = split ? t.split[k] : columns > 1 ? t.batched[k] : t.singleton[k];
+    counter.fetch_add(1, std::memory_order_relaxed);
+}
+struct scope {
+    bool active;
+    inline static thread_local unsigned depth[COUNT]{};
+    kind k;
+    scope(kind which, bool split, long long columns) : active(enabled()), k(which) {
+        if (active && depth[k]++ == 0) { record(k, split, columns); }
+    }
+    ~scope() { if (active) { --depth[k]; } }
+};
+}

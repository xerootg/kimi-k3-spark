     GGML_ASSERT(cplan->work_size == 0 || cplan->work_data != NULL);
 
+    ggml_graph_prefetch_mul_mat_id(cgraph);
+
     int n_threads                               = cplan->n_threads;
     struct ggml_threadpool * threadpool = cplan->threadpool;
 

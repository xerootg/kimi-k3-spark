+// kimi-k3-spark patch 0055: per-client priority (see server-context.h)
+namespace {
+struct server_client_class {
+    int         priority = 0;
+    std::string name;
+};
+struct server_client_classes {
+    std::unordered_map<std::string, server_client_class> by_key;
+    int  top     = 0;     // highest configured priority
+    bool enabled = false;
+};
+server_client_classes & client_classes() {
+    static server_client_classes c;
+    return c;
+}
+int env_int(const char * name, int def) {
+    const char * v = std::getenv(name);
+    return v && *v ? std::atoi(v) : def;
+}
+} // namespace
+
+void server_client_classes_load(common_params & params) {
+    const char * path = std::getenv("LLAMA_CLIENT_CLASSES");
+    if (path == nullptr || *path == 0) {
+        return;
+    }
+    std::ifstream f(path);
+    if (!f) {
+        throw std::runtime_error(std::string("LLAMA_CLIENT_CLASSES: cannot open ") + path);
+    }
+    auto & c = client_classes();
+    std::string line;
+    int n = 0;
+    while (std::getline(f, line)) {
+        const size_t hash = line.find('#');
+        if (hash != std::string::npos) {
+            line.resize(hash);
+        }
+        std::istringstream ls(line);
+        std::string key, name;
+        int prio = 0;
+        if (!(ls >> key)) {
+            continue;
+        }
+        if (!(ls >> prio)) {
+            throw std::runtime_error("LLAMA_CLIENT_CLASSES: a line has a key but no priority");
+        }
+        if (!(ls >> name)) {
+            name = "class" + std::to_string(prio);
+        }
+        if (c.by_key.empty() || prio > c.top) {
+            c.top = prio;
+        }
+        c.by_key[key] = { prio, name };
+        if (std::find(params.api_keys.begin(), params.api_keys.end(), key) == params.api_keys.end()) {
+            params.api_keys.push_back(key);
+        }
+        n++;
+    }
+    c.enabled = n > 0;
+    SRV_INF("client classes: %d keys loaded, top priority %d (keys not logged)\n", n, c.top);
+}
+
+int server_client_priority(const std::map<std::string, std::string> & headers, std::string * name) {
+    const auto & c = client_classes();
+    if (!c.enabled) {
+        return 0;
+    }
+    std::string key;
+    for (const auto & [k, v] : headers) {
+        std::string lk = k;
+        std::transform(lk.begin(), lk.end(), lk.begin(), [](unsigned char ch) { return (char) std::tolower(ch); });
+        if (lk == "authorization") {
+            key = v;
+            const std::string prefix = "Bearer ";
+            if (key.compare(0, prefix.size(), prefix) == 0) {
+                key = key.substr(prefix.size());
+            }
+            break;
+        }
+        if (lk == "x-api-key") {
+            key = v;
+        }
+    }
+    const auto it = c.by_key.find(key);
+    if (it == c.by_key.end()) {
+        return 0;
+    }
+    if (name) {
+        *name = it->second.name;
+    }
+    return it->second.priority;
+}

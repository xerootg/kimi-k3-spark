+// Same per-channel arithmetic as ssm_conv_f32 (token 0 of n_t, no bias): taps x[0..d_conv-2] from the cache,
+// x[d_conv-1] the new input, then sumf += x[j] * w[j] in j order, sumf += 0, optional silu.
+template <bool apply_silu, size_t split_d_inner, size_t d_conv>
+static __global__ void ssm_conv_state_f32(const ggml_cuda_conv_state_args a, const float * src1_ptr, const int src1_nb1,
+                                          float * dst_ptr) {
+    ggml_cuda_pdl_lc();
+    const int tid  = threadIdx.x;
+    const int bidy = blockIdx.y;
+
+    const float * w_block = (const float *) ((const char *) src1_ptr + bidy * split_d_inner * src1_nb1);
+    const int stride_w = src1_nb1 / sizeof(float);
+    const int64_t c = (int64_t) bidy * split_d_inner + tid;
+
+    float x[d_conv] = { 0.0f };
+    float w[d_conv] = { 0.0f };
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (size_t j = 0; j < d_conv; j++) {
+        w[j] = w_block[tid * stride_w + j];
+    }
+
+    float b = 0.0f;
+
+    const float * st = a.table + (int64_t) a.ids[0] * a.row_stride + a.read_off + c * (int64_t) (d_conv - 1);
+    for (size_t j = 0; j < d_conv - 1; j++) {
+        x[j] = st[j];
+    }
+    x[d_conv - 1] = a.xnew[c];
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (size_t j = 0; j < d_conv; j++) {
+        sumf += x[j % d_conv] * w[j];
+    }
+    sumf += b;
+    dst_ptr[c] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+
+    float * wr = a.write + c * (int64_t) (d_conv - 1);
+    for (size_t j = 0; j < d_conv - 1; j++) {
+        wr[j] = x[j + 1];
+    }
+}

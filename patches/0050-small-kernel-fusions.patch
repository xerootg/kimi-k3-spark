+            (t->flags & GGML_TENSOR_FLAG_COMPUTE) ? "" : " NOCOMP", t->view_src ? " VIEW" : "");
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * s = t->src[j];
+            if (!s) { continue; }
+            fprintf(f, " | s%d %s %s %s [%lld,%lld,%lld,%lld] %p", j, s->name, ggml_op_desc(s), ggml_type_name(s->type),
+                (long long) s->ne[0], (long long) s->ne[1], (long long) s->ne[2], (long long) s->ne[3], s->data);
+        }
+        fprintf(f, "\n");
+    }
+    return f;
+}

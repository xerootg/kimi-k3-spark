index 2379aae..7f273dc 100644
--- a/ggml/src/ggml-cuda/dsv4-hc.cuh
+++ b/ggml/src/ggml-cuda/dsv4-hc.cuh
@@ -4,3 +4,17 @@
 void ggml_cuda_op_dsv4_hc_comb(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 void ggml_cuda_op_dsv4_hc_pre(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
 void ggml_cuda_op_dsv4_hc_post(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+// Fused weight chain (GGML_CUDA_FUSE_HC=1): w[h] = scale_bias(sigmoid(mix[h]*s + b[h])) computed inside HC_PRE / HC_POST.
+// Single-token only. Bit-identical to the MUL -> ADD -> SIGMOID -> SCALE kernels it replaces.
+struct ggml_cuda_hc_affine {
+    const float * mix;   // first of hc values, element stride mix_s
+    int64_t       mix_s;
+    const float * s;     // scalar
+    const float * b;     // hc values, element stride b_s
+    int64_t       b_s;
+    float         sc;    // SCALE op params
+    float         bi;
+};
+void ggml_cuda_op_dsv4_hc_pre_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_hc_affine & w);
+void ggml_cuda_op_dsv4_hc_post_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_hc_affine & w);
diff --git a/ggml/src/ggml-cuda/fused-small.cu b/ggml/src/ggml-cuda/fused-small.cu
new file mode 100644
index 0000000..948b55d
--- /dev/null
+++ b/ggml/src/ggml-cuda/fused-small.cu
@@ -0,0 +1,42 @@
+#include "fused-small.cuh"
+
+// MUL: k_bin_bcast op_mul (FMUL). SCALE: scale_f32 (FFMA scale*x + bias). SIGMOID: unary op_sigmoid.
+static __global__ void k_mul_scale_sigmoid_scale(
+        const float * x, const float * b, float * dst,
+        const int64_t ne0, const int64_t ne1,
+        const int64_t sx1, const int64_t sb0, const int64_t sb1, const int64_t sd1,
+        const float s1, const float c1, const float s2, const float c2) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= ne0 * ne1) {
+        return;
+    }
+    ggml_cuda_pdl_sync();
+    const int64_t i0 = i % ne0;
+    const int64_t i1 = i / ne0;
+    const float t1 = __fmul_rn(x[i1*sx1 + i0], b[i1*sb1 + i0*sb0]);
+    const float t2 = __fmaf_rn(s1, t1, c1);
+    const float sg = 1.0f / (1.0f + expf(-t2));
+    dst[i1*sd1 + i0] = __fmaf_rn(s2, sg, c2);
+}
+
+void ggml_cuda_op_mul_scale_sigmoid_scale(ggml_backend_cuda_context & ctx, const ggml_tensor * mul,
+                                          const ggml_tensor * sc1, const ggml_tensor * sc2, ggml_tensor * dst) {
+    const ggml_tensor * x = mul->src[0];
+    const ggml_tensor * b = mul->src[1];
+    const int64_t ne0 = mul->ne[0];
+    const int64_t ne1 = mul->ne[1];
+    GGML_ASSERT(x->nb[0] == sizeof(float) && b->nb[0] == sizeof(float) && dst->nb[0] == sizeof(float));
+    const int64_t sx1 = x->nb[1] / sizeof(float);
+    const int64_t sb0 = b->ne[0] == 1 ? 0 : 1;
+    const int64_t sb1 = b->ne[1] == 1 ? 0 : (int64_t) (b->nb[1] / sizeof(float));
+    const int64_t sd1 = dst->nb[1] / sizeof(float);
+    const int block_size = 256;
+    const int64_t n = ne0 * ne1;
+    const ggml_cuda_kernel_launch_params launch_params =
+        ggml_cuda_kernel_launch_params(dim3((n + block_size - 1) / block_size, 1, 1), dim3(block_size, 1, 1), 0, ctx.stream());
+    ggml_cuda_kernel_launch(k_mul_scale_sigmoid_scale, launch_params,
+        (const float *) x->data, (const float *) b->data, (float *) dst->data, ne0, ne1, sx1, sb0, sb1, sd1,
+        ggml_get_op_params_f32(sc1, 0), ggml_get_op_params_f32(sc1, 1),
+        ggml_get_op_params_f32(sc2, 0), ggml_get_op_params_f32(sc2, 1));
+}

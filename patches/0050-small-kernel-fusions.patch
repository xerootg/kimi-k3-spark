diff --git a/ggml/src/ggml-cuda/dsv4-hc.cu b/ggml/src/ggml-cuda/dsv4-hc.cu
index ca1d2dc..6ed6080 100644
--- a/ggml/src/ggml-cuda/dsv4-hc.cu
+++ b/ggml/src/ggml-cuda/dsv4-hc.cu
@@ -314,3 +314,129 @@ void ggml_cuda_op_dsv4_hc_post(ggml_backend_cuda_context & ctx, ggml_tensor * ds
             nbc0 / sizeof(float), nbc1 / sizeof(float), nbc2 / sizeof(float),
             nbd0 / sizeof(float), nbd1 / sizeof(float), nbd2 / sizeof(float));
 }
+
+// ---- fused weight chain (GGML_CUDA_FUSE_HC) ----
+// The separate kernels round after every op: MUL (k_bin_bcast, FMUL), ADD (FADD), SIGMOID (unary op_sigmoid),
+// SCALE (scale_f32, FFMA scale*x + bias). __fmul_rn/__fadd_rn keep the first two from contracting into an FMA.
+static __device__ __forceinline__ float dsv4_hc_affine_w(const ggml_cuda_hc_affine & w, int64_t h) {
+    const float t1 = __fmul_rn(w.mix[h*w.mix_s], w.s[0]);
+    const float t2 = __fadd_rn(t1, w.b[h*w.b_s]);
+    const float sg = 1.0f / (1.0f + expf(-t2));
+    return __fmaf_rn(w.sc, sg, w.bi);
+}
+
+static __global__ void dsv4_hc_pre_fused_f32(
+        const float * x,
+        const ggml_cuda_hc_affine w,
+        float * dst,
+        int64_t n_embd,
+        int64_t hc,
+        int64_t sx0,
+        int64_t sx1,
+        int64_t sd0,
+        float   scale) {
+    ggml_cuda_pdl_lc();
+    const int64_t i0 = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+
+    if (i0 >= n_embd) {
+        return;
+    }
+
+    ggml_cuda_pdl_sync();
+
+    float sum = 0.0f;
+    for (int64_t ih = 0; ih < hc; ++ih) {
+        const float xv = x[i0*sx0 + ih*sx1];
+        const float wv = dsv4_hc_affine_w(w, ih);
+        sum += xv * wv;
+    }
+
+    dst[i0*sd0] = scale * sum;
+}
+
+static __global__ void dsv4_hc_post_fused_f32(
+        const float * x,
+        const float * residual,
+        const ggml_cuda_hc_affine w,
+        const float * comb,
+        float * dst,
+        int64_t n_embd,
+        int64_t hc,
+        int64_t sx0,
+        int64_t sr0,
+        int64_t sr1,
+        int64_t sc0,
+        int64_t sc1,
+        int64_t sd0,
+        int64_t sd1) {
+    ggml_cuda_pdl_lc();
+    const int64_t ir = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t nr = n_embd * hc;
+
+    if (ir >= nr) {
+        return;
+    }
+
+    ggml_cuda_pdl_sync();
+
+    const int64_t i0   = ir % n_embd;
+    const int64_t idst = ir / n_embd;
+
+    const float post = dsv4_hc_affine_w(w, idst);
+    float sum = x[i0*sx0] * post;
+    for (int64_t isrc = 0; isrc < hc; ++isrc) {
+        sum += residual[i0*sr0 + isrc*sr1] * comb[idst*sc0 + isrc*sc1];
+    }
+
+    dst[i0*sd0 + idst*sd1] = sum;
+}
+
+void ggml_cuda_op_dsv4_hc_pre_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_hc_affine & w) {
+    const ggml_tensor * x = dst->src[0];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[2] == 1 && ggml_get_op_params_i32(dst, 1) == 0);
+
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+    const float   scale  = ggml_get_op_params_f32(dst, 0);
+
+    const int block_size = 256;
+    const dim3 block_dims(block_size, 1, 1);
+    const dim3 grid_dims((n_embd + block_size - 1) / block_size, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+
+    ggml_cuda_kernel_launch(dsv4_hc_pre_fused_f32, launch_params,
+            (const float *) x->data, w, (float *) dst->data,
+            n_embd, hc,
+            (int64_t) (x->nb[0] / sizeof(float)), (int64_t) (x->nb[1] / sizeof(float)),
+            (int64_t) (dst->nb[0] / sizeof(float)),
+            scale);
+}
+
+void ggml_cuda_op_dsv4_hc_post_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ggml_cuda_hc_affine & w) {
+    const ggml_tensor * x        = dst->src[0];
+    const ggml_tensor * residual = dst->src[1];
+    const ggml_tensor * comb     = dst->src[3];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && residual->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(comb && comb->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[1] == 1);
+
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = residual->ne[1];
+
+    const int block_size = 256;
+    const int64_t nr = n_embd * hc;
+    const dim3 block_dims(block_size, 1, 1);
+    const dim3 grid_dims((nr + block_size - 1) / block_size, 1, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+
+    ggml_cuda_kernel_launch(dsv4_hc_post_fused_f32, launch_params,
+            (const float *) x->data, (const float *) residual->data, w, (const float *) comb->data, (float *) dst->data,
+            n_embd, hc,
+            (int64_t) (x->nb[0] / sizeof(float)),
+            (int64_t) (residual->nb[0] / sizeof(float)), (int64_t) (residual->nb[1] / sizeof(float)),
+            (int64_t) (comb->nb[0] / sizeof(float)), (int64_t) (comb->nb[1] / sizeof(float)),
+            (int64_t) (dst->nb[0] / sizeof(float)), (int64_t) (dst->nb[1] / sizeof(float)));
+}

+        const ggml_tensor * t = cgraph->nodes[i];
+        fprintf(f, "N %d %s %s %s [%lld,%lld,%lld,%lld] nb[%zu,%zu,%zu] %p%s%s", i, ggml_op_desc(t), t->name, ggml_type_name(t->type),

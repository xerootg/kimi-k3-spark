+// LLAMA_LOGITS_FNV=1 (debug): log an FNV-1a hash of every decode's last logits row, to compare builds bit for bit.
+static ggml_tensor * g_dbg_logits = nullptr;
+static int64_t      g_dbg_logits_row = 0;
+static void llama_dbg_logits_hash() {
+    static const bool on = getenv("LLAMA_LOGITS_FNV") != nullptr;
+    if (!on || !g_dbg_logits) { return; }
+    static int64_t n_calls = 0;
+    static uint64_t chain = 1469598103934665603ULL;
+    const int64_t n = g_dbg_logits->ne[0];
+    std::vector<uint8_t> buf(n * sizeof(float));
+    ggml_backend_tensor_get(g_dbg_logits, buf.data(), g_dbg_logits_row * g_dbg_logits->nb[1], buf.size());
+    uint64_t h = 1469598103934665603ULL;
+    for (uint8_t b : buf) { h = (h ^ b) * 1099511628211ULL; chain = (chain ^ b) * 1099511628211ULL; }
+    fprintf(stderr, "LOGITS_FNV %lld %016llx chain %016llx\n", (long long) n_calls++, (unsigned long long) h, (unsigned long long) chain);
+    g_dbg_logits = nullptr;
+}

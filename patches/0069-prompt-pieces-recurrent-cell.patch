+llama_rs_frozen_split::llama_rs_frozen_split(const llama_memory_recurrent * recr, llama_batch_allocr & balloc) : balloc(balloc) {
+    if (recr == nullptr || recr->frozen < 0) {
+        return;
+    }
+    const int32_t frozen = recr->frozen;
+    const llama_batch & batch = balloc.get_batch();
+    const size_t size = recr->cells.size();
+
+    std::vector<bool> below(size, false);
+    std::vector<bool> above(size, false);
+    std::vector<bool> seen (size, false);
+    bool any_below = false;
+    bool any_above = false;
+    std::vector<llama_seq_id> alone;
+
+    for (int32_t i = 0; i < batch.n_tokens; ++i) {
+        const llama_seq_id sid = batch.seq_id[i][0];
+        if (sid < 0 || (size_t) sid >= size || seen[sid]) {
+            continue; // an id out of range is in no group: the batch is not consumed and init_batch fails
+        }
+        seen[sid] = true;
+        const int32_t tail = recr->cells[sid].tail;
+        const bool owns = tail >= 0 && recr->cells[tail].seq_id.size() == 1;
+        if (owns && tail < frozen) {
+            below[sid] = true; any_below = true;
+        } else if (owns && tail > frozen) {
+            above[sid] = true; any_above = true;
+        } else {
+            alone.push_back(sid); // no cell of its own (or the frozen cell itself: find_slot refuses it)
+        }
+    }
+    if (any_below) { groups.push_back(std::move(below)); }
+    if (any_above) { groups.push_back(std::move(above)); }
+    for (llama_seq_id sid : alone) {
+        std::vector<bool> g(size, false);
+        g[sid] = true;
+        groups.push_back(std::move(g));
+    }
+    if (groups.empty()) {
+        groups.emplace_back(size, false);
+    }
+    balloc.split_allow(&groups[0]);
+}
+
+llama_rs_frozen_split::~llama_rs_frozen_split() {
+    balloc.split_allow(nullptr);
+}
+
+bool llama_rs_frozen_split::next_group() {
+    if (cur + 1 >= groups.size()) {
+        return false;
+    }
+    balloc.split_allow(&groups[++cur]);
+    return true;
+}

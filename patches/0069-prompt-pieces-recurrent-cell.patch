+uint64_t llama_memory_recurrent::seq_state_hash(llama_seq_id seq_id) const {
+    if (seq_id < 0 || (size_t) seq_id >= cells.size() || cells[seq_id].tail < 0) {
+        return 0;
+    }
+    const size_t cell = (size_t) cells[seq_id].tail;
+    uint64_t h = 1469598103934665603ull;
+    std::vector<uint8_t> buf;
+    for (const auto * tensors : { &r_l, &s_l, &p_l }) {
+        for (ggml_tensor * t : *tensors) {
+            if (t == nullptr) {
+                continue;
+            }
+            const size_t row = ggml_row_size(t->type, t->ne[0]);
+            buf.resize(row);
+            ggml_backend_tensor_get(t, buf.data(), cell*row, row);
+            for (size_t i = 0; i < row; ++i) {
+                h = (h ^ buf[i]) * 1099511628211ull;
+            }
+        }
+    }
+    return h;
+}

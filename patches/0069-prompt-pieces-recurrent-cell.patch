+    // kimi-k3-spark patch 0069: the accounts belong to one generating class. When the top generating class changes (the
+    // higher class's answer ends, or it starts), they start again: before, a prompt held to 12 % while the higher class
+    // generated then ran alone until it had caught up to the same-class share (50 %) of that whole time, and the
+    // answers of its own class stopped for seconds after the higher class was done.
+    void pp_regime(int hi) {
+        if (hi != pp_hi_last) {
+            pp_hi_last = hi;
+            pp_t_pp_us = pp_t_dec_us = 0;
+            pp_lo_pp_us = pp_lo_dec_us = 0;
+            pp_solo_us = 0;
+        }
+    }
+
+    // is a prompt of a class lower than `hi` waiting or pending?
+    bool pp_lower_class_prompt(int hi) const {
+        for (const auto & slot : slots) {
+            if (slot.task && (slot.pp_pending || slot.state == SLOT_STATE_STARTED || slot.state == SLOT_STATE_PROCESSING_PROMPT) &&
+                    (int) slot.task->params.client_priority < hi) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // kimi-k3-spark patch 0069: while a higher class generates (with the decode share), the lower classes' share of
+    // the time is split between their prompt pieces and their decode steps by LLAMA_PREFILL_SLICE_SHARE_SAME, as it
+    // is between them when the higher class is not there. Before, the prompt pieces took the share whenever it was
+    // free and the lower classes' answers stopped until the higher class was done. true: the prompt goes next;
+    // false: the lower classes' decode steps do (they join the higher class's next steps).
+    bool pp_lower_prompt_turn(int prio) {
+        const int hi = pp_top_generating();
+        const double s = pp_share_same();
+        if (s <= 0.0 || !pp_decode_share() || hi == INT_MIN || prio >= hi) {
+            return true;
+        }
+        bool gen = false;
+        for (const auto & slot : slots) {
+            if (slot.task && slot.state == SLOT_STATE_GENERATING && (int) slot.task->params.client_priority < hi) {
+                gen = true;
+                break;
+            }
+        }
+        if (!gen) {
+            pp_lo_pp_us = pp_lo_dec_us = 0; // nobody to share with: nothing to account
+            return true;
+        }
+        return (double) pp_lo_pp_us <= s/(1.0 - s)*(double) pp_lo_dec_us;
+    }

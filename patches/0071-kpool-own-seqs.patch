+        const bool on = e != nullptr && atoi(e) != 0;
+        if (on) {
+            LLAMA_LOG_INFO("%s: LLAMA_KPOOL_OWN_SEQS=1: a ubatch's pool list holds its own sequences only (patch 0071)\n", "kpool_build_state");
+        }
+        return on;
+    }();
+    st.own = own_seqs && idx->get_n_stream() > 1;
+    st.seq_on.fill(st.own ? 0 : 1);
+    if (st.own) {
+        for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {

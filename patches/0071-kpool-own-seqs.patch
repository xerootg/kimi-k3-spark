+        if (st.seq_on[s]) {
+            n_pool_list += (uint32_t) lay.seqs[s].pools.size();
+        }
+    }
+    GGML_ASSERT(st.own || n_pool_list == lay.n_pool_real);
+
+    st.n_pool_real = n_pool_list;
     st.n_new       = 0;
     if (++st.generation == 0) {
         std::fill(st.is_new.begin(),  st.is_new.end(),  0);
         std::fill(st.rep_gen.begin(), st.rep_gen.end(), 0);

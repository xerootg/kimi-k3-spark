@@ -654,14 +662,52 @@ void llama_memory_hybrid_idx_context::kpool_build_state(const llama_ubatch & uba
     const uint32_t kv_size = idx->get_size();
     const uint32_t kpool   = mem->get_kpool();
 
-    st.n_pool_real = lay.n_pool_real;
+    // patch 0071: list only the pools of the sequences this ubatch decodes, plus those of sequences an edit staled
+    // (the first ubatch of a batch re-pools them, as before). A token only ever selects visible pools of its own

+// kimi-k3-spark patch 0056: GGML_CUDA_BI_ATTN_CHUNK=<cells> (unset or 0: one block per output tile, as in 0054): the
+// fixed chunk of a stream's sparse index list that one block of batch-invariant decode attention covers. The value
+// changes the bytes (another split), so a server keeps one value.
+static inline int ggml_cuda_bi_attn_chunk() {
+    static const int chunk = [] {
+        const char * e = getenv("GGML_CUDA_BI_ATTN_CHUNK");
+        return e != nullptr ? std::max(0, atoi(e)) : 0;
+    }();
+    return chunk;
+}
+
+// kimi-k3-spark patch 0056: GGML_CUDA_BI_FUSE=1 keeps, in batch-invariant mode, the one-column variants that compute
+// the same bits as the plain kernels: the matvec fusions (gate/up/GLU, bias, routed+shared expert) and the small-K
+// row packing. Patch 0054 turned them off; with them a token's bytes stay the same (measured, docs/experiments.md).
+static inline bool ggml_cuda_bi_fuse() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_BI_FUSE");
+        return e != nullptr && strcmp(e, "1") == 0;
+    }();
+    return on;
+}
+
+// kimi-k3-spark patch 0056: GGML_CUDA_BI_TOPK_SORT=1 keeps patch 0054's batch-invariant top-k (sort the whole row)
+// instead of the exact radix select; both give the same bytes.
+static inline bool ggml_cuda_bi_topk_sort() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_BI_TOPK_SORT");
+        return e != nullptr && strcmp(e, "1") == 0;
+    }();
+    return on;
+}

diff --git a/ggml/src/ggml-cuda/top-k.cu b/ggml/src/ggml-cuda/top-k.cu
index 6f4c1b5..e86794c 100644
--- a/ggml/src/ggml-cuda/top-k.cu
+++ b/ggml/src/ggml-cuda/top-k.cu
@@ -278,6 +278,185 @@ static void top_k_argsort_cuda(
     }
 }
 
+// patch 0056: exact batch-invariant top-k by radix select. The result is defined by the total order of patch 0054
+// (value descending with -0 equal to +0, then lower index first): the k first entries of that order, in that order.
+// Every key (value, index) is unique, so any exact algorithm gives the same bytes; this one reads the row five times
+// (four 8-bit histogram passes for the k-th value, one ordered pass that keeps the k winners) and sorts only the k
+// winners in shared memory, where 0054 sorted the whole row. One block per row: nothing depends on the other rows.
+static __device__ __forceinline__ uint32_t top_k_bi_key(const float v) {
+    const uint32_t b = __float_as_uint(v == 0.0f ? 0.0f : v); // -0 sorts with +0
+    return (b & 0x80000000u) ? ~b : (b | 0x80000000u);         // larger float -> larger key
+}
+
+template <int nthreads>
+__launch_bounds__(nthreads, 1)
+static __global__ void k_top_k_bi_exact(const float * __restrict__ x, int * __restrict__ dst, const int ncols, const int k,
+                                        const int k_pad) {
+    extern __shared__ unsigned long long top_k_bi_cand[]; // k_pad keys: (key << 32) | ~index, 0 = padding
+    __shared__ uint32_t hist[256];
+    __shared__ uint32_t warp_cnt[nthreads/WARP_SIZE];
+    __shared__ uint32_t s_prefix;
+    __shared__ uint32_t s_mask;
+    __shared__ uint32_t s_need;  // winners still to place among the keys that match the prefix
+    __shared__ uint32_t s_taken; // winners collected
+    __shared__ uint32_t s_eq_seen;
+    __shared__ bool     s_done;
+
+    static_assert(nthreads % WARP_SIZE == 0 && nthreads/WARP_SIZE <= WARP_SIZE, "bad nthreads");
+    const int     tid  = threadIdx.x;
+    const int     lane = tid % WARP_SIZE;
+    const int     warp = tid / WARP_SIZE;
+    const float * xr   = x   + int64_t(blockIdx.x)*ncols;
+    int         * dr   = dst + int64_t(blockIdx.x)*k;
+
+    if (tid == 0) {
+        s_prefix = 0;
+        s_mask   = 0;
+        s_need   = k;
+    }
+
+    // the k-th largest key, 8 bits at a time from the top
+    for (int shift = 24; shift >= 0; shift -= 8) {
+        for (int i = tid; i < 256; i += nthreads) {
+            hist[i] = 0;
+        }
+        __syncthreads();
+        const uint32_t prefix = s_prefix;
+        const uint32_t mask   = s_mask;
+        for (int i = tid; i < ncols; i += nthreads) {
+            const uint32_t u = top_k_bi_key(xr[i]);
+            if ((u & mask) == prefix) {
+                atomicAdd(&hist[(u >> shift) & 0xFF], 1u);
+            }
+        }
+        __syncthreads();
+        if (warp == 0) {
+            // lane l owns bins 255-8l down to 248-8l; find the bin where the count from the top reaches s_need
+            const uint32_t need = s_need;
+            uint32_t sum = 0;
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                sum += hist[255 - 8*lane - j];
+            }
+            uint32_t incl = sum;
+#pragma unroll
+            for (int off = 1; off < WARP_SIZE; off <<= 1) {
+                const uint32_t t = __shfl_up_sync(0xFFFFFFFF, incl, off);
+                if (lane >= off) {
+                    incl += t;
+                }
+            }
+            const uint32_t excl  = incl - sum;
+            const uint32_t found = __ballot_sync(0xFFFFFFFF, incl >= need);
+            const int      owner = __ffs(found) - 1; // found != 0: the matching keys number at least need
+            if (lane == owner) {
+                uint32_t acc = excl;
+                int bin = 255 - 8*lane;
+                for (int j = 0; j < 7; ++j, --bin) {
+                    const uint32_t h = hist[bin];
+                    if (acc + h >= need) {
+                        break;
+                    }
+                    acc += h;
+                }
+                s_need   = need - acc;
+                s_prefix = prefix | (uint32_t(bin) << shift);
+                s_mask   = mask   | (0xFFu << shift);
+            }
+        }
+        __syncthreads();
+    }
+
+    // keep every key above the k-th and the first (by index) s_need keys equal to it
+    const uint32_t kth   = s_prefix;
+    const uint32_t n_eq  = s_need;
+    if (tid == 0) {
+        s_taken   = 0;
+        s_eq_seen = 0;
+    }
+    __syncthreads();
+    for (int base = 0; base < ncols; base += nthreads) {
+        const int i = base + tid;
+        uint32_t u  = 0;
+        if (i < ncols) {
+            u = top_k_bi_key(xr[i]);
+        }
+        const bool     gt  = i < ncols && u >  kth;
+        const bool     eq  = i < ncols && u == kth;
+        const uint32_t bal = __ballot_sync(0xFFFFFFFF, eq);
+        if (lane == 0) {
+            warp_cnt[warp] = __popc(bal);
+        }
+        __syncthreads();
+        uint32_t before = s_eq_seen + __popc(bal & ((1u << lane) - 1u));
+        for (int w = 0; w < warp; ++w) {
+            before += warp_cnt[w];
+        }
+        if (gt || (eq && before < n_eq)) {
+            const uint32_t slot = atomicAdd(&s_taken, 1u);
+            top_k_bi_cand[slot] = (uint64_t(u) << 32) | uint64_t(0xFFFFFFFFu - uint32_t(i));
+        }
+        __syncthreads();
+        if (tid == 0) {
+            uint32_t total = 0;
+            for (int w = 0; w < nthreads/WARP_SIZE; ++w) {
+                total += warp_cnt[w];
+            }
+            s_eq_seen += total;
+            s_done     = s_taken >= uint32_t(k);
+        }
+        __syncthreads();
+        if (s_done) {
+            break; // uniform: s_done changes only between the next two barriers
+        }
+    }
+    for (int j = k + tid; j < k_pad; j += nthreads) {
+        top_k_bi_cand[j] = 0;
+    }
+    __syncthreads();
+
+    // sort the winners, largest key first (keys are unique, padding last)
+    for (int kk = 2; kk <= k_pad; kk <<= 1) {
+        for (int j = kk >> 1; j > 0; j >>= 1) {
+            for (int t = tid; t < k_pad; t += nthreads) {
+                const int ixj = t ^ j;
+                if (ixj > t) {
+                    const unsigned long long a = top_k_bi_cand[t];
+                    const unsigned long long b = top_k_bi_cand[ixj];
+                    if ((t & kk) == 0 ? a < b : a > b) {
+                        top_k_bi_cand[t]   = b;
+                        top_k_bi_cand[ixj] = a;
+                    }
+                }
+            }
+            __syncthreads();
+        }
+    }
+    for (int j = tid; j < k; j += nthreads) {
+        dr[j] = int(0xFFFFFFFFu - uint32_t(top_k_bi_cand[j] & 0xFFFFFFFFull));
+    }
+}
+
+// false: not handled (k too large for shared memory), the caller sorts
+static bool top_k_bi_exact_cuda(const float * x, int * dst, const int64_t ncols, const int64_t nrows, const int64_t k,
+                                cudaStream_t stream) {
+    if (k < 1 || k > ncols || ncols > INT_MAX || nrows > INT_MAX) {
+        return false;
+    }
+    const int    k_pad  = next_power_of_2((int) k);
+    const size_t nbytes = size_t(k_pad) * sizeof(unsigned long long);
+    if (nbytes > ggml_cuda_info().devices[ggml_cuda_get_device()].smpb) {
+        return false;
+    }
+    if (ncols <= 2048) {
+        k_top_k_bi_exact<256><<<(int) nrows, 256, nbytes, stream>>>(x, dst, (int) ncols, (int) k, k_pad);
+    } else {
+        k_top_k_bi_exact<1024><<<(int) nrows, 1024, nbytes, stream>>>(x, dst, (int) ncols, (int) k, k_pad);
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}

+        (void) cudaGetLastError();
+        return SIZE_MAX;
+    }
+    if (shrink) {
+        bool synced = false;
+        for (size_t c = 0; c < n_chunks; ++c) {
+            if (m.is_mapped[c] && !want[c]) {
+                if (!synced) {
+                    CUDA_CHECK(cudaDeviceSynchronize()); // no kernel may still read what is unmapped
+                    synced = true;
+                }
+                CU_CHECK(cuMemUnmap(base + c*m.chunk, m.chunk));
+                m.is_mapped[c] = 0;
+                m.mapped -= m.chunk;
+            }
+        }
+    }
+    return m.mapped;
+#else
+    GGML_UNUSED(buffer);
+    GGML_UNUSED(offs);
+    GGML_UNUSED(lens);
+    GGML_UNUSED(n);
+    GGML_UNUSED(shrink);
+    return SIZE_MAX;
+#endif

+static size_t ggml_backend_cuda_elastic_buffer_set_ranges(ggml_backend_buffer_t buffer, const size_t * offs, const size_t * lens, size_t n, bool shrink) {
+#if defined(GGML_USE_VMM)
+    if (buffer == nullptr || !ggml_backend_buffer_is_cuda(buffer)) {
+        return SIZE_MAX;
+    }
+    ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
+    if (!ctx->elastic) {
+        return SIZE_MAX;
+    }

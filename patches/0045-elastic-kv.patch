+    prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id = (int) cu_dev;
+    CUmemAccessDesc access = {};
+    access.location = prop.location;
+    access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    const CUdeviceptr base = (CUdeviceptr) ctx->dev_ptr;
+    bool failed = false;
+    for (size_t c = 0; c < n_chunks && !failed;) {
+        if (!want[c] || m.is_mapped[c]) {
+            c++;
+            continue;
+        }
+        size_t e = c;
+        while (e < n_chunks && want[e] && !m.is_mapped[e]) {
+            CUmemGenericAllocationHandle h;
+            if (cuMemCreate(&h, m.chunk, &prop, 0) != CUDA_SUCCESS) {
+                failed = true;
+                break;
+            }
+            if (cuMemMap(base + e*m.chunk, m.chunk, 0, h, 0) != CUDA_SUCCESS) {
+                cuMemRelease(h);
+                failed = true;
+                break;
+            }
+            CU_CHECK(cuMemRelease(h)); // the mapping keeps the memory until it is unmapped
+            m.is_mapped[e] = 1;
+            m.mapped += m.chunk;
+            e++;
+        }
+        if (e > c) {
+            CU_CHECK(cuMemSetAccess(base + c*m.chunk, (e - c)*m.chunk, &access, 1));
+            CUDA_CHECK(cudaMemsetAsync((void *) (base + c*m.chunk), 0, (e - c)*m.chunk, cudaStreamPerThread));
+        }
+        c = e;
+    }
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));

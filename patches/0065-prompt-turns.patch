+    // kimi-k3-spark patch 0065: LLAMA_PREFILL_TURNS=1: prompts of one class take turns, one ubatch each (the prompt
+    // that waited longest goes next; a new prompt goes first), instead of each prompt running to its end before the
+    // next one starts. A short prompt then waits for one ubatch of a long one, not for all of it. Every ubatch is
+    // computed the same way whenever it runs (0055 already relies on this for a higher class's prompt).
+    static bool pp_turns() {
+        static const bool on = env_int("LLAMA_PREFILL_TURNS", 0) == 1;
+        return on;
+    }
+
+    // does slot a's prompt go before slot b's (same class)? A prompt that has not started yet first, then the one
+    // whose last ubatch is oldest; ties: the oldest task.
+    static bool pp_turn_before(const server_slot & a, const server_slot & b) {
+        const int64_t ta = a.state == SLOT_STATE_STARTED ? 0 : a.pp_turn;
+        const int64_t tb = b.state == SLOT_STATE_STARTED ? 0 : b.pp_turn;
+        return ta < tb || (ta == tb && a.task->id < b.task->id);
+    }
+
     // does a prompt of class `prio` share the GPU with the generating class `hi` (and not simply run first)?
     static bool pp_contends(int prio, int hi) {
         return hi != INT_MIN && (prio < hi || (prio == hi && pp_share_same() > 0.0));

+    __shared__ int warp_counts[32];
+    __shared__ int base;
+    const int lane    = threadIdx.x & 31;
+    const int warp    = threadIdx.x >> 5;
+    const int n_warps = blockDim.x >> 5;
+    if (threadIdx.x == 0) {
+        base = 0;
+    }
+    __syncthreads();
+    for (int e0 = 0; e0 < n_experts; e0 += blockDim.x) {

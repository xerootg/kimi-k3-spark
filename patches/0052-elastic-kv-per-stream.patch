+// kimi-k3-spark patch 0052: elastic KV per stream
+
+const llama_kv_cache::elastic_policy_t & llama_kv_cache::elastic_policy() {
+    static const elastic_policy_t p = [] {
+        elastic_policy_t r;
+        if (const char * v = getenv("LLAMA_ELASTIC_KV_REFUSE")) {
+            r.refuse = strcmp(v, "1") == 0;
+        }
+        if (const char * v = getenv("LLAMA_ELASTIC_KV_FLOOR_MIB")) {
+            r.floor = (size_t) std::max(0, atoi(v)) << 20;
+        }
+        if (const char * v = getenv("LLAMA_ELASTIC_KV_STREAM_MAX")) {
+            r.stream_max = (uint32_t) std::max(0, atoi(v));
+        }
+        return r;
+    }();
+    return p;
+}
+
+static size_t elastic_mem_available() {
+    FILE * f = fopen("/proc/meminfo", "r");
+    if (f == nullptr) {
+        return SIZE_MAX;
+    }
+    char line[256];
+    size_t kb = SIZE_MAX;
+    while (fgets(line, sizeof(line), f)) {
+        if (strncmp(line, "MemAvailable:", 13) == 0) {
+            kb = (size_t) strtoull(line + 13, nullptr, 10);
+            break;
+        }
+    }
+    fclose(f);
+    return kb == SIZE_MAX ? SIZE_MAX : kb*1024;
+}
+
+static std::mutex elastic_registry_mutex;
+static std::vector<std::pair<llama_kv_cache *, const llama_model *>> elastic_registry;
+
+void llama_kv_cache::elastic_registry_add(llama_kv_cache * kv, const llama_model * mdl) {
+    std::lock_guard<std::mutex> lock(elastic_registry_mutex);
+    elastic_registry.emplace_back(kv, mdl);
+}
+
+llama_kv_cache::~llama_kv_cache() {
+    if (elastic_ms) {
+        std::lock_guard<std::mutex> lock(elastic_registry_mutex);
+        elastic_registry.erase(std::remove_if(elastic_registry.begin(), elastic_registry.end(),
+            [this](const auto & e) { return e.first == this; }), elastic_registry.end());
+    }
+}
+
+void llama_kv_cache::elastic_fit_used_ms(bool shrink, const char * why) {
+    const uint32_t pad = std::max(n_pad, 256u);
+    for (uint32_t s = 0; s < n_stream; ++s) {
+        const uint32_t used = v_cells[s].used_max_p1();
+        const uint32_t need = GGML_PAD(used, pad) + pad;
+        if (need > elastic_cells_s[s]) {
+            elastic_fit_stream(s, need + elastic_margin, false, false, why);
+        } else if (shrink && elastic_cells_s[s] > need + elastic_margin + elastic_shrink) {
+            elastic_fit_stream(s, need + elastic_margin, true, false, why);
+        }
+    }
+}
+
+bool llama_kv_cache::elastic_fit_stream(uint32_t s, uint32_t n_cells, bool shrink, bool may_refuse, const char * why) {
+    n_cells = std::min(n_cells, get_size());
+    if (n_cells == elastic_cells_s[s]) {
+        return true;
+    }
+    if (elastic_set_ranges_fn == nullptr) {
+        for (int i = 0; i < (int) ggml_backend_reg_count() && elastic_set_ranges_fn == nullptr; ++i) {
+            elastic_set_ranges_fn = (decltype(elastic_set_ranges_fn)) ggml_backend_reg_get_proc_address(ggml_backend_reg_get(i), "ggml_backend_cuda_elastic_buffer_set_ranges");
+        }
+        GGML_ASSERT(elastic_set_ranges_fn != nullptr);
+    }
+    const auto & pol = elastic_policy();
+    const bool grow = n_cells > elastic_cells_s[s];
+    const size_t delta = (size_t) (grow ? n_cells - elastic_cells_s[s] : elastic_cells_s[s] - n_cells)*elastic_cell_bytes;
+    if (grow) {
+        llama_moe_cache_make_room(delta); // the expert cache gives the memory back before the GPU takes it
+        if (may_refuse && pol.refuse) {
+            const size_t avail = elastic_mem_available();
+            if (avail != SIZE_MAX && avail < delta + pol.floor) {
+                LLAMA_LOG_WARN("%s: elastic KV %s%s(%s) stream %u: REFUSED %u -> %u cells (%.2f GB): MemAvailable %.2f GB, floor %.2f GB\n", __func__,
+                    elastic_tag, elastic_tag[0] ? " " : "", why, s, elastic_cells_s[s], n_cells, delta/1e9, avail/1e9, pol.floor/1e9);
+                return false;
+            }
+        }
+    }
+    const auto t0 = ggml_time_us();
+    const uint32_t old = elastic_cells_s[s];
+    elastic_cells_s[s] = n_cells;
+    size_t mapped = 0;
+    std::vector<size_t> offs, lens;
+    for (auto & eb : elastic_bufs) {
+        offs.clear();
+        lens.clear();
+        for (size_t i = 0; i < eb.offs.size(); ++i) {
+            for (uint32_t st = 0; st < n_stream; ++st) {
+                offs.push_back(eb.offs[i] + (size_t) st*eb.strs[i]);
+                lens.push_back((size_t) elastic_cells_s[st]*eb.rows[i]);
+            }
+        }
+        size_t r = elastic_set_ranges_fn(eb.buf, offs.data(), lens.data(), offs.size(), shrink && !grow);
+        for (int attempt = 0; r == SIZE_MAX && attempt < (may_refuse ? 1 : 3); ++attempt) {
+            LLAMA_LOG_WARN("%s: elastic KV: mapping %u cells of stream %u failed, asking the expert cache for %.2f GB more\n", __func__, n_cells, s, delta/1e9);
+            llama_moe_cache_make_room(2*delta + ((size_t) 1 << 30));
+            r = elastic_set_ranges_fn(eb.buf, offs.data(), lens.data(), offs.size(), false);
+        }
+        if (r == SIZE_MAX) {
+            if (may_refuse) {
+                // whatever got mapped stays mapped until the stream's next shrink
+                elastic_cells_s[s] = old;
+                LLAMA_LOG_WARN("%s: elastic KV %s%s(%s) stream %u: REFUSED %u -> %u cells: the device could not map them\n", __func__,
+                    elastic_tag, elastic_tag[0] ? " " : "", why, s, old, n_cells);
+                return false;
+            }
+            GGML_ABORT("elastic KV: could not map %u cells of stream %u", n_cells, s);
+        }
+        mapped += r;
+    }
+    LLAMA_LOG_INFO("%s: elastic KV %s%s(%s) stream %u: %u -> %u of %u cells, %.1f MiB mapped in all streams (%.1f ms)\n", __func__,
+        elastic_tag, elastic_tag[0] ? " " : "", why, s, old, n_cells, get_size(), mapped/1024.0/1024.0, (ggml_time_us() - t0)/1000.0);
+    return true;
+}
+
+bool llama_kv_cache::elastic_reserve(llama_seq_id seq_id, uint32_t n_cells) {
+    const auto & pol = elastic_policy();
+    if (!elastic_ms || (!pol.refuse && pol.stream_max == 0)) {
+        return true; // no policy: streams grow in apply_ubatch as in patch 0045
+    }
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+    const uint32_t s = seq_to_stream[seq_id];
+    if (pol.stream_max > 0 && n_cells > pol.stream_max) {
+        LLAMA_LOG_WARN("%s: elastic KV %s%sstream %u: REFUSED %u cells: over the fixed share of %u cells\n", __func__,
+            elastic_tag, elastic_tag[0] ? " " : "", s, n_cells, pol.stream_max);
+        return false;
+    }
+    const uint32_t pad  = std::max(n_pad, 256u);
+    const uint32_t need = GGML_PAD(n_cells, pad) + pad;
+    if (need <= elastic_cells_s[s]) {
+        return true;
+    }
+    return elastic_fit_stream(s, need + elastic_margin, false, true, "reserve");
+}
+
+bool llama_elastic_kv_reserve(llama_context * ctx, llama_seq_id seq_id, int32_t n_cells) {
+    const llama_model * mdl = ctx != nullptr ? &ctx->get_model() : nullptr;
+    std::lock_guard<std::mutex> lock(elastic_registry_mutex);
+    bool ok = true;
+    for (auto & [kv, m] : elastic_registry) {
+        if (mdl == nullptr || m == mdl) {
+            ok = kv->elastic_reserve(seq_id, (uint32_t) std::max(0, n_cells)) && ok;
+            if (!ok) {
+                break;
+            }
+        }
+    }
+    return ok;
+}

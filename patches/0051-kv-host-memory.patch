+        bound > 0 ? "bound" : bound < 0 ? "bind FAILED" : "single node", mask, n_nodes, dptr == p ? "==" : "!=");
+    ggml_backend_cuda_buffer_context * ctx = new ggml_backend_cuda_buffer_context(device, dptr);
+    ctx->host_ptr = p;
+    ctx->host_size = map_size;
+    return ggml_backend_buffer_init(ggml_backend_cuda_buffer_type(device), ggml_backend_cuda_buffer_interface, ctx, size);
+#else
+    GGML_UNUSED(device);
+    GGML_UNUSED(size);
+    GGML_UNUSED(thp);
+    return nullptr;
+#endif

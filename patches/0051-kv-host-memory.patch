+        munmap(p, map_size);
+        return nullptr;
+    }
+    GGML_LOG_INFO("%s: %.2f MiB of host memory for device %d: THP %s (%.0f%% huge), NUMA %s (cpu node mask 0x%lx of %d nodes), device address %s host address\n",

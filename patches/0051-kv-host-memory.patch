+            unsigned long a, b;
+            size_t kb;
+            if (sscanf(line, "%lx-%lx", &a, &b) == 2 && strchr(line, ' ') != nullptr && strchr(line, '-') < strchr(line, ' ')) {
+                in = a >= (uintptr_t) p && b <= (uintptr_t) p + map_size;
+            } else if (in && sscanf(line, "AnonHugePages: %zu kB", &kb) == 1) {

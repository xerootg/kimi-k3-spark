+            int n = 0;
+            if (sscanf(e->d_name, "node%d", &n) != 1 || n < 0 || n >= 64) {
+                continue;
+            }
+            n_nodes++;
+            const std::string path = std::string("/sys/devices/system/node/") + e->d_name + "/cpulist";
+            char line[64] = {0};
+            if (FILE * f = fopen(path.c_str(), "r")) {
+                if (fgets(line, sizeof(line), f) == nullptr) {
+                    line[0] = 0;
+                }
+                fclose(f);
+            }
+            if (line[0] >= '0' && line[0] <= '9') {

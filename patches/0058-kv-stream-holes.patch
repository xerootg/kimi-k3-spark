+    const auto & cur = sinfos[i_cur];
+    offs.clear();
+    for (uint32_t s = 0; s < cur.n_stream(); ++s) {
+        offs.push_back((int32_t) cur.strm[s] - (int32_t) cur.s0);
+    }
+    return cur.s1 - cur.s0 + 1;

+void llama_context::pp_swap() {
+    std::swap(sched, pp_alt.sched);
+    std::swap(gf_res_prev, pp_alt.gf_res_prev);
+    std::swap(gf_res_prev_active, pp_alt.gf_res_prev_active);
+    pp_swapped = !pp_swapped;

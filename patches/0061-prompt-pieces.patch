+int32_t llama_context::decode_resume() {
+    if (!pp_pend.active) {
+        LLAMA_LOG_ERROR("%s: no prompt is being computed in pieces\n", __func__);
+        return -1;
+    }
+    pp_swap();
+    bool done = false;
+    const ggml_status status = graph_compute_piece(pp_pend.res->get_gf(), false, done);
+    if (status != GGML_STATUS_SUCCESS) {
+        // as decode() does for a failed ubatch: remove its positions from the memory
+        const auto & ub = *pp_pend.ubatch;
+        llama_pos pos_min = std::numeric_limits<llama_pos>::max();
+        llama_seq_id seq = ub.seq_id[0][0];
+        for (uint32_t i = 0; i < ub.n_tokens; ++i) {
+            pos_min = std::min(pos_min, ub.pos[i]);
+        }
+        pp_pend = pp_pending_t();
+        pp_swap();
+        LLAMA_LOG_WARN("%s: removing memory module entries for seq_id = %d, pos = [%d, +inf)\n", __func__, seq, pos_min);
+        memory->seq_rm(seq, pos_min, -1);
+        return status == GGML_STATUS_ABORTED ? 2 : -3;
+    }
+    if (!done) {
+        pp_swap();
+        return 3;
+    }
+    // the last piece: the outputs as decode() would have left them
+    std::swap(balloc, pp_pend.balloc);
+    if (output_reserve(pp_pend.n_outputs_all) < pp_pend.n_outputs_all) {
+        LLAMA_LOG_ERROR("%s: could not reserve space for batch with %d outputs\n", __func__, (int) pp_pend.n_outputs_all);
+        pp_pend = pp_pending_t();
+        pp_swap();
+        return -2;
+    }
+    output_swaps.clear();
+    embd_batch_idxs.clear();
+    embd_seq.clear();
+    for (const auto & entry : sampling.samplers) {
+        llama_sampler_backend_begin(entry.second);
+    }
+    n_outputs = pp_pend.n_outputs_ub;
+    decode_ubatch_out(pp_pend.res, *pp_pend.ubatch, 0, 0, pp_pend.n_outputs_all, pp_pend.has_samplers);
+    decode_map_outputs(pp_pend.n_outputs_all);
+    static const bool log_pieces = getenv("LLAMA_PREFILL_SLICE_LOG") != nullptr;
+    if (log_pieces) {
+        LLAMA_LOG_INFO("%s: prompt ubatch of %u tokens done in %d pieces, %.1f ms of GPU time\n", __func__,
+            pp_pend.ubatch->n_tokens, pp_pend.part.n_calls, pp_pend.t_us/1000.0);
+    }
+    pp_pend = pp_pending_t();
+    pp_swap();
+    return 0;
+}

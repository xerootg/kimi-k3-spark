+ggml_status llama_context::graph_compute_piece(ggml_cgraph * gf, bool first, bool & done) {
+    const int64_t t0 = ggml_time_us();
+    if (first) {
+        int n_threads = cparams.n_threads_batch;
+        if (backend_cpu != nullptr) {
+            auto * reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend_cpu));
+            auto * set_threadpool_fn = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
+            if (set_threadpool_fn) {
+                set_threadpool_fn(backend_cpu, threadpool_batch);
+            }
+        }
+        for (const auto & set_n_threads_fn : set_n_threads_fns) {
+            set_n_threads_fn.second(set_n_threads_fn.first, n_threads);
+        }
+        copy_experts.reset();
+        if (moe_cache) {
+            moe_cache->prefill_reset();
+        }
+    } else {
+        // the decodes in between set their own thread counts
+        if (backend_cpu != nullptr) {
+            auto * reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend_cpu));
+            auto * set_threadpool_fn = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
+            if (set_threadpool_fn) {
+                set_threadpool_fn(backend_cpu, threadpool_batch);
+            }
+        }
+        for (const auto & set_n_threads_fn : set_n_threads_fns) {
+            set_n_threads_fn.second(set_n_threads_fn.first, cparams.n_threads_batch);
+        }
+    }
+    const ggml_status status = ggml_backend_sched_graph_compute_part(sched.get(), gf, &pp_pend.part, 1, pp_can_stop, this, &done);
+    ggml_backend_sched_synchronize(sched.get());
+    pp_pend.t_us += ggml_time_us() - t0;
+    if (status != GGML_STATUS_SUCCESS) {
+        LLAMA_LOG_ERROR("%s: ggml_backend_sched_graph_compute_part failed with error %d\n", __func__, status);
+    }
+    return status;
+}

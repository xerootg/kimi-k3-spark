+
+// a prompt ubatch: one sequence, more tokens than there are slots, one ubatch, no embeddings output. Decode steps (one
+// token per sequence) and prompts of at most n_seq_max tokens keep the main scheduler, whose buffer is sized for the
+// batched decode graph (patch 0059), so its graphs stay that small.
+bool llama_context::pp_route(const llama_batch_ext & batch) const {
+    if (cparams.embeddings || batch.tokens.size() <= std::max<size_t>(1, cparams.n_seq_max) || batch.tokens.size() > cparams.n_ubatch) {
+        return false;
+    }
+    llama_seq_id seq = -1;
+    for (const auto & tok : batch.tokens) {
+        if (tok.seq_ids.size() != 1) {
+            return false;
+        }
+        const llama_seq_id s = *tok.seq_ids.begin();
+        if (seq >= 0 && s != seq) {
+            return false;
+        }
+        seq = s;
+    }
+    return seq >= 0;
+}
+
+// the layer index of a node from its name ("attn_norm-12", "ffn_moe_out-12 (reshaped)"), -1 if none
+static int pp_layer_of(const ggml_tensor * t) {
+    const char * n = t->name;
+    const char * dash = nullptr;
+    for (const char * p = n; *p; ++p) {
+        if (*p == '-' && p[1] >= '0' && p[1] <= '9') {
+            dash = p;
+        }
+    }
+    if (dash == nullptr) {
+        return -1;
+    }
+    int v = 0;
+    const char * p = dash + 1;
+    for (; *p >= '0' && *p <= '9'; ++p) {
+        v = v*10 + (*p - '0');
+    }
+    return (*p == '\0' || *p == ' ') ? v : -1;
+}
+
+// a piece ends between the last node of layer L and the first node of layer L + 1, where L + 1 is a multiple of k:
+// every node of layer L (the MoE lookups and the matmuls that read the looked-up slots included) has run, nothing of
+// layer L + 1 has
+// (nodes without a layer name, such as views and unnamed intermediates, count for the last named layer before them; the
+// scan runs forward over the graph, so the last named layer is carried across calls)
+bool llama_context::pp_can_stop(const ggml_tensor * prev, const ggml_tensor * next, void * ud) {
+    auto * c = static_cast<llama_context *>(ud);
+    const int lp = pp_layer_of(prev);
+    if (lp >= 0) {
+        c->pp_pend.last_layer = lp;
+    }
+    const int ln = pp_layer_of(next);
+    return c->pp_pend.cut_ok && c->pp_pend.last_layer >= 0 && ln == c->pp_pend.last_layer + 1 && ln % c->pp_slice_layers == 0;
+}

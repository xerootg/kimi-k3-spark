+ggml_tensor * llama_kv_cache_context::get_k_stream(ggml_context * ctx, int32_t il, uint32_t stream) const {
+    const auto & current = sinfos[i_cur];
+    GGML_ASSERT(stream < current.n_stream());
+    llama_kv_cache::slot_info sinfo{}; // get_k uses only s0/s1, no vector copy
+    sinfo.s0 = sinfo.s1 = current.strm[stream];
+    auto * k = kv->get_k(ctx, il, get_n_kv_stream(stream), sinfo);
+    // The singleton stream stride must not depend on total cache capacity.
+    return ggml_view_4d(ctx, k, k->ne[0], k->ne[1], k->ne[2], 1,
+        k->nb[1], k->nb[2], k->nb[2]*k->ne[2], 0);

+    size_t releasable_host() {
+        if (!valve_thread.joinable() || valve_broken) {
+            return 0;
+        }
+        std::lock_guard<std::recursive_mutex> lock(lru_mutex);
+        size_t r = 0;
+        for (size_t ig = 0; ig < groups.size(); ++ig) {
+            const group & g = groups[ig];
+            if (g.region == nullptr || g.n_slots == 0) {
+                continue;
+            }
+            const int32_t lo = g.lru.n_hbm;
+            const int32_t hi = g.n_slots;
+            if (hi <= lo) {
+                continue;
+            }
+            const size_t n        = (size_t) (hi - lo);
+            const size_t keep_min = n*valve_floor_pct/100;
+            const size_t gone     = valve_released_host[ig].size();
+            if (n > keep_min + gone) {
+                r += (n - keep_min - gone)*g.slot_stride;
+            }
+        }
+        return r;
+    }

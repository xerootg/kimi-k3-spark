+    const uint32_t pad  = std::max(n_pad, 256u);
+    const uint32_t need = GGML_PAD(n_cells, pad) + pad;
+    elastic_reserved_s[s] = std::min(need, get_size());
+    if (need <= elastic_cells_s[s]) {
+        return true;
+    }
+    // the accounting over all caches was done by the caller (llama_elastic_kv_reserve): a growth to the floor is
+    // never refused for lack of MemAvailable, only if the device cannot map it; a burst was checked there
+    const bool ok = elastic_fit_stream(s, need + elastic_margin, false, true, burst ? "reserve, burst" : "reserve", false);
+    if (!ok && !burst) {
+        LLAMA_LOG_ERROR("%s: elastic KV %s%sstream %u: could not map %u cells UNDER the floor of %u (the device refused the mapping)\n",
+            __func__, elastic_tag, elastic_tag[0] ? " " : "", s, n_cells, elastic_policy().floor_cells);
+    }
+    return ok;
+}

+        const size_t nb = remotes.size();
+        bool any = false;
+        for (size_t bx = 0; bx < nb; ++bx) {
+            remote_cnt[bx] = 0;
+            remote_slot[bx] = nullptr;
+            remote_usable[bx] = remotes[bx]->next_free() != nullptr;
+            any = any || remote_usable[bx];
+        }
+        if (!any) {
+            return 0;
+        }
+        for (size_t i = 0; i < n_ids; ++i) {
+            rc_uses[ids_data[i]]++;
+        }
+        size_t taken = 0;
+        for (int pass = 0; pass < 2; ++pass) {
+            for (size_t u = 0; u < n_union; ++u) {
+                const int32_t x = cols_ids[u];
+                const int uses = rc_uses[x];
+                if (rc_mark[x] || (pass == 0) != (uses == 1)) {
+                    continue;
+                }
+                const int bx = (int) remote_box[(size_t) il*store.n_expert + x] - 1;
+                if (bx < 0 || !remote_usable[bx]) {
+                    continue;
+                }
+                if (!remote_cols_resident && g.lru.slot_map[il][x] >= 0) {
+                    continue;
+                }
+                const int cap = remote_adapt ? remote_cap_cur[(n_ids/8)*nb + bx] : remote_box_rows[std::min((size_t) bx, remote_box_rows.size() - 1)];
+                if (remote_cnt[bx] + uses > cap || taken + uses > (size_t) remote_cols_rmax) {
+                    continue;
+                }
+                rc_mark[x] = (uint8_t) (bx + 1);
+                remote_cnt[bx] += uses;
+                taken += uses;
+            }
+        }
+        for (size_t u = 0; u < n_union; ++u) {
+            rc_uses[cols_ids[u]] = 0;
+        }
+        if (taken == 0) {
+            return 0;
+        }
+        int32_t off = 0;
+        for (size_t bx = 0; bx < nb; ++bx) {
+            remote_off[bx] = off;
+            off += remote_cnt[bx];
+        }
+        remote_fill_at.assign(remote_off.begin(), remote_off.end());
+        for (size_t i = 0; i < n_ids; ++i) {
+            const int32_t x = ids_data[i];
+            if (rc_mark[x]) {
+                const int bx = rc_mark[x] - 1;
+                const int k = remote_fill_at[bx]++;
+                rc_gid[k] = il*(int32_t) store.n_expert + x;
+                rc_col[k] = (int32_t) (i/8);
+                rc_pos[k] = (int32_t) i;
+                rc_exp[k] = x;
+            }
+        }
+        memcpy(remote_cols_ids, ids_data, n_ids*sizeof(int32_t));
+        remote_cols_nids = n_ids;
+        remote_cols_nc = n_ids/8;
+        remote_cols_nunion = n_union;
+        remote_il = il;
+        remote_is_cols = true;
+        n_remote_layers++;
+        n_rc_pairs_posted += taken;
+        remote_post_cols(il);
+        return taken;
+    }

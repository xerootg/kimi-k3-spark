+    // window nd: one request per box with pairs: the inputs of the tokens it needs (compacted), the (gid, token) pairs
+    void remote_post_cols(int32_t il) {
+        const layer & l = layers[il];
+        std::atomic_thread_fence(std::memory_order_acquire);
+        const float * xin = (const float *) l.remote_x->data;
+        bool posted = false;
+        for (size_t bx = 0; bx < remotes.size(); ++bx) {
+            const int k = remote_cnt[bx];
+            if (k == 0) {
+                continue;
+            }
+            remote_client & rc = *remotes[bx];
+            remote_client::slot * s = rc.next_free();
+            if (s == nullptr) {
+                rc.n_unsent++;
+                continue;
+            }
+            const int off = remote_off[bx];
+            int tmap[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+            int nt = 0;
+            for (int r = 0; r < k; ++r) {
+                const int c = rc_col[off + r];
+                if (tmap[c] < 0) {
+                    tmap[c] = nt;
+                    memcpy(s->x.data() + (size_t) nt*rc.n_in, xin + (size_t) c*rc.n_in, (size_t) rc.n_in*sizeof(float));
+                    nt++;
+                }
+            }
+            s->hdr[0] = (int32_t) (remote_client::ND_MAGIC | (uint32_t) k);
+            s->hdr[1] = nt;
+            s->hdr[2] = (int32_t) rc.n_posts;
+            s->hdr[3] = il;
+            for (int r = 0; r < remote_client::KND; ++r) {
+                s->hdr[4 + 2*r] = r < k ? rc_gid[off + r] : 0;
+                s->hdr[5 + 2*r] = r < k ? tmap[rc_col[off + r]] : 0;
+            }
+            s->k = k;
+            s->ntok = nt;
+            s->tseq = -1;
+            rc.post(s);
+            remote_slot[bx] = s;
+            rc.n_posts++;
+            rc.n_rows += k;
+            posted = true;
+        }
+        n_rc_layers_posted += posted;
+    }

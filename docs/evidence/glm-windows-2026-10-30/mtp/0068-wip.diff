+// kimi-k3-spark patch 0068: exact speculative decoding.
+//
+// LLAMA_SPEC_EXACT=1 (exact value, inert when unset) makes speculation invisible in the output: a slot's bytes are the
+// same with and without drafts, alone and batched. Three parts:
+//  - the draft is verified with the sampler of the slot, one sample and one accept per emitted token, so the sampler
+//    state (RNG included) advances exactly as without drafts; a draft token is kept only if it is the token that was
+//    sampled (the rejection and replay verifiers, which change the output distribution's realisation, are not used);
+//  - the batch that holds draft tokens is computed with llama_set_exact_verify, so every logits row has the bits of
+//    the single-token decode step it replaces, and it holds no prompt tokens (LLAMA_PREFILL_ISOLATE=1 is required);
+//  - the slot's token list, context and stop checks advance one emitted token at a time, as without drafts.
+// Every sequence of such a batch gets the same number of draft tokens, so the batch is one ubatch (one forward pass)
+// and the rollback snapshots of the recurrent layers are valid without [TAG_RECURRENT_ROLLBACK_SPLITS].
+//
+// LLAMA_SPEC_EXACT_COLS (default 4): columns (sequences x tokens) of a batch with drafts; with G slots generating
+// each gets floor(cols / G) - 1 draft tokens, so drafting stops by itself when the step is already full of clients.
+// LLAMA_SPEC_EXACT_TRACE=1 (debug): log slot, index, token and an FNV-1a hash of the logits row of every sampled token.
+static bool server_spec_exact() {
+    static const bool on = [] {
+        const char * e = std::getenv("LLAMA_SPEC_EXACT");
+        if (e == nullptr || std::strcmp(e, "1") != 0) {
+            return false;
+        }
+        // a prompt ubatch must not share a batch with draft tokens: it would be computed with the verification graph
+        const char * iso = std::getenv("LLAMA_PREFILL_ISOLATE");
+        if (iso == nullptr || std::strcmp(iso, "1") != 0) {
+            GGML_ABORT("LLAMA_SPEC_EXACT=1 requires LLAMA_PREFILL_ISOLATE=1");
+        }
+        return true;
+    }();
+    return on;
+}
+
+static int server_spec_exact_cols() {
+    static const int cols = [] {
+        const char * e = std::getenv("LLAMA_SPEC_EXACT_COLS");
+        const int v = e != nullptr ? atoi(e) : 4;
+        return std::max(1, std::min(v, 64));
+    }();
+    return cols;
+}
+
+// LLAMA_SPEC_EXACT_COUPLED (default 1; 0 = the drafter's own greedy pick): the drafter samples every draft token with
+// a copy of the slot's sampler, i.e. with the chain and the random draws the target will use. It changes which
+// tokens are drafted, never what is emitted.
+static bool server_spec_exact_coupled() {
+    static const bool on = [] {
+        const char * e = std::getenv("LLAMA_SPEC_EXACT_COUPLED");
+        return e == nullptr || std::strcmp(e, "0") != 0;
+    }();
+    return on;
+}
+
+static void server_spec_trace(int slot_id, int64_t i_gen, llama_token id, llama_context * ctx, int idx) {
+    static const bool on = [] {
+        const char * e = std::getenv("LLAMA_SPEC_EXACT_TRACE");
+        return e != nullptr && std::strcmp(e, "1") == 0;
+    }();
+    if (!on) {
+        return;

@@ -1590,7 +1721,9 @@ llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, ll
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
 
+    bi_dump_begin(ubatch, gtype != LLM_GRAPH_TYPE_ENCODER && gtype != LLM_GRAPH_TYPE_DECODER_MTP);
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
+    bi_dump_end();
     if (status != GGML_STATUS_SUCCESS) {

+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstddef>
+
+// Shared by the engine and the host completion tests. All times use steady_clock.
+namespace remote_hedge {
+inline uint64_t now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+struct completion {
+    std::atomic<std::size_t> left{0};
+    std::atomic<uint64_t> done{0};
+};
+enum winner { outstanding, local, remote };
+inline winner choose(uint64_t local_at, uint64_t remote_at, bool finite, uint64_t deadline) {
+    if (remote_at && finite && remote_at <= deadline && (!local_at || remote_at < local_at)) {
+        return remote;
+    }
+    return local_at ? local : outstanding; // a deadline never cancels the local hedge
+}

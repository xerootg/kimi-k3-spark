+// kimi-k3-spark patch 0070: one context at a time behind the host-bank hook.
+//
+// The hook's state is shared by every context of the process: the mailboxes are indexed by stream number (every
+// context uses number 0, so two contexts share one mailbox and one done flag), and the expert store behind the hook
+// has one slot pool whose plan only protects the layer being looked up. Two contexts with lookups in flight at the
+// same time therefore corrupt each other: the second context's request overwrites the ids the poller is reading,
+// one done flag releases both waits, and a lookup then reads a slot map that was not filled for it (-1 as an expert
+// slot, or the expert store's "has slot -1 after the plan" abort). This happened with the MTP draft context, whose
+// catch-up decode (common_speculative_process) is launched after every target batch and not synchronized; the
+// server now synchronizes the draft context before the target's next decode.
+//
+// This is the tripwire for any other such caller: when a context starts sending lookups while the stream of the
+// context that sent the previous ones still has work pending, abort with a message that names the cause instead
+// of serving wrong bytes. One pointer compare per lookup while the owner does not change; one cudaStreamQuery
+// when it does. GGML_CUDA_HOST_BANK_OWNER_CHECK=0 turns it off (tests of the tripwire itself).
+static void ggml_cuda_host_bank_owner_check(ggml_backend_cuda_context & ctx) {
+    ggml_backend_cuda_context * prev = g_bank_owner.load(std::memory_order_relaxed);
+    if (prev == &ctx) {
+        return;
+    }
+    static const bool enabled = [] { const char * e = getenv("GGML_CUDA_HOST_BANK_OWNER_CHECK"); return !(e != nullptr && e[0] == '0'); }();
+    if (prev != nullptr && enabled) {
+        const cudaError_t err = cudaStreamQuery(prev->stream());
+        (void) cudaGetLastError();
+        if (err == cudaErrorNotReady) {
+            GGML_ABORT("host bank: context %s starts expert lookups while context %s still has work in flight; "
+                       "contexts that share the expert store must be synchronized before another one decodes "
+                       "(llama_synchronize)", ctx.name.c_str(), prev->name.c_str());
+        }
+    }
+    ctx.host_bank_user = true;
+    g_bank_owner.store(&ctx, std::memory_order_relaxed);
+}
